{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "agent-companion",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "d1_databases": [{"binding":"DB","database_name":"agent-companion","database_id":"00000000-0000-0000-0000-000000000001","migrations_dir":"migrations"}],
  "vars": {"BUNDLE_ID":"com.example.agentcompanion","WIDGET_BUNDLE_ID":"com.example.agentcompanion.widgets","APNS_ENVIRONMENT":"production"},
  "triggers": {"crons":["* * * * *"]},
  "observability": {"enabled":true}
}
